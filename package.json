{
  "name": "melvor-bank-layout",
  "version": "0.1.1",
  "description": "Melvor Idle mod: sorts every item into a planned bank tab and makes new items land there too.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CardSwim8/melvor-item-sorting.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "changelog": "node scripts/changelog.mjs",
    "index": "node scripts/item-index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "linkedom": "^0.18.14",
    "prettier": "^3.9.10"
  }
}
